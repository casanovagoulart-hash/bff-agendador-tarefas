# =====================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE - ECOSSISTEMA AGENDADOR DE TAREFAS
# =====================================================================
# INSTRUÇÕES DE USO:
# 1. Copie este arquivo e renomeie a cópia para ".env" (na mesma pasta).
# 2. Preencha os valores abaixo com suas credenciais locais.
# 3. NUNCA envie o arquivo ".env" preenchido para o GitHub.
# =====================================================================

# --------------------- BANCO DE DADOS (POSTGRESQL) ---------------------
# Senha de acesso ao banco relacional do microsserviço 'usuario'
DB_PASSWORD=defina_uma_senha_forte_aqui

# --------------------- SEGURANÇA E CRIPTOGRAFIA (JWT) ------------------
# Chave secreta compartilhada entre BFF, Usuario e Agendador (mínimo 64 bytes para HS512).
# Gere uma nova chave segura rodando no PowerShell:
# $bytes = New-Object byte[] 96; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=cole_aqui_sua_chave_gerada_em_base64

# --------------------- SERVIÇO DE E-MAIL (SMTP GMAIL) ------------------
# Conta Gmail remetente e Senha de App de 16 letras (gerada em ://google.com)
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_16_letras

# --------------------- ROBÔ DE AGENDAMENTO (CRON SERVICE) --------------
# Credenciais de um usuário válido cadastrado via POST /usuario para o Cron autenticar
USUARIO_CRON_EMAIL=cron@agendador.com
USUARIO_CRON_SENHA=defina_a_senha_do_robo_aqui

# INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
GEMINI_API_KEY=
